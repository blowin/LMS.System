@page "/register"
@using LMS.System.Domain.Services.AccountManagers.Auth
@using LMS.System.Domain.Services.DBServices.DBContext
@using LMS.System.Domain.Services.DBServices.Models
@using LMS.System.Domain.Services.DBServices.Models.Enums
@using Microsoft.EntityFrameworkCore
@using BCrypt.Net
@inject IJwtService JwtService
@inject NavigationManager NavigationManager
@inject ApplicationContext DbContext

<MudGrid Justify="Justify.Center" Style="height: 100vh;">
    <MudItem xs="12" sm="8" md="6" lg="4">
        <MudPaper Class="pa-8" Elevation="10">
            <MudText Typo="Typo.h4" Class="text-center mb-6">Регистрация</MudText>

            <MudForm @ref="_form" @bind-IsValid="_isValid" @bind-Errors="_errors">
                <MudTextField @bind-Value="FirstName"
                              Label="Имя"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Required="true"
                              RequiredError="Введите имя" />

                <MudTextField @bind-Value="LastName"
                              Label="Фамилия"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Class="mt-4" />

                <MudTextField @bind-Value="Email"
                              Label="Email"
                              Variant="Variant.Outlined"
                              FullWidth="true"
                              Required="true"
                              RequiredError="Введите email"
                              Class="mt-4" />

                <MudTextField @bind-Value="Password"
                              Label="Пароль"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              FullWidth="true"
                              Required="true"
                              RequiredError="Введите пароль"
                              Class="mt-4" />

                <MudTextField @bind-Value="ConfirmPassword"
                              Label="Подтверждение пароля"
                              Variant="Variant.Outlined"
                              InputType="InputType.Password"
                              FullWidth="true"
                              Required="true"
                              RequiredError="Подтвердите пароль"
                              Class="mt-4" />

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
                }

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-6"
                           OnClick="HandleRegister"
                           Disabled="_isLoading">
                    Зарегистрироваться
                    @if (_isLoading)
                    {
                        <MudProgressCircular Color="Color.Default" Size="Size.Small" Class="ml-2" />
                    }
                </MudButton>
            </MudForm>

            <MudText Class="text-center mt-4">
                Уже есть аккаунт? <MudLink Href="/login">Войти</MudLink>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private MudForm? _form;
    private bool _isValid;
    private bool _isLoading = false;
    private string[] _errors = Array.Empty<string>();
    private string _errorMessage = string.Empty;

    private string FirstName { get; set; } = string.Empty;
    private string LastName { get; set; } = string.Empty;
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;

    private async Task HandleRegister()
    {
        if (_form is null) return;

        await _form.Validate();
        if (!_isValid) return;

        if (Password != ConfirmPassword)
        {
            _errorMessage = "Пароли не совпадают";
            return;
        }

        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            // Проверка, что email не занят
            if (await DbContext.Users.AnyAsync(u => u.Email == Email))
            {
                _errorMessage = "Этот email уже зарегистрирован";
                return;
            }

            // Создание нового пользователя
            var user = new User
            {
                FirstName = FirstName,
                LastName = LastName,
                Email = Email,
                PasswordHash = BCrypt.HashPassword(Password), 
                Role = EVRole.Student,
                CreatedAt = DateTime.UtcNow
            };
            
            await DbContext.Users.AddAsync(user);
            await DbContext.SaveChangesAsync();

            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Ошибка регистрации: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
